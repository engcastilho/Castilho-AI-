# Serviço do systemd: mantém o Castilho AI rodando no servidor e o reinicia
# sozinho se ele cair ou se o servidor for reiniciado.
# Instalação: cp deploy/castilho-ai.service /etc/systemd/system/

[Unit]
Description=Castilho AI (chatbot)
After=network.target

[Service]
User=castilho
Group=castilho
WorkingDirectory=/home/castilho/Castilho-AI-
ExecStart=/home/castilho/Castilho-AI-/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
