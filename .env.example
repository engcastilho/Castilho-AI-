# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# ---- Opcionais ----
# CHAT_MODEL=claude-opus-5-5          # claude-sonnet-5-5 e claude-haiku-5-5 são mais baratos
# CHAT_EFFORT=medium                  # low | medium | high | xhigh | max
# CHAT_MAX_TOKENS=64000
# CHAT_DB_PATH=data/chat.db
# CHAT_SYSTEM_PROMPT="Você é o Castilho AI, um assistente prestativo..."

# ---- Login ----
# REGISTRATION_MODE=approval          # approval (você aprova) | open (livre) | closed (fechado)
# DAILY_MESSAGE_LIMIT=50              # mensagens por usuário a cada 24h (0 = sem limite)
# SESSION_DAYS=30                     # dias até pedir login de novo
# COOKIE_SECURE=true                  # use true no servidor, com HTTPS
